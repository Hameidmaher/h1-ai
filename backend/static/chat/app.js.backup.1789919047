/* ═══════════════════════════════════════════════════════════
   H1-AI Chat — Frontend Logic
   ═══════════════════════════════════════════════════════════ */

const API_BASE = window.location.origin;
const PHARMACY_ID = "00000000-0000-0000-0000-000000000001";

// ─── State ──────────────────────────────────────────────
let sessionId = null;
let userId = localStorage.getItem('h1ai_user_id') || generateUserId();
let isWaiting = false;

if (!localStorage.getItem('h1ai_user_id')) {
    localStorage.setItem('h1ai_user_id', userId);
}

function generateUserId() {
    return 'web_' + Math.random().toString(36).substring(2, 15);
}

// ─── DOM refs ───────────────────────────────────────────
const chatEl = document.getElementById('chat');
const formEl = document.getElementById('form');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('sendBtn');
const typingEl = document.getElementById('typing');
const sessionInfoEl = document.getElementById('sessionInfo');
const newChatBtn = document.getElementById('newChat');
const clearChatBtn = document.getElementById('clearChat');

// ─── Init ───────────────────────────────────────────────
document.querySelectorAll('.suggestion').forEach(btn => {
    btn.addEventListener('click', () => {
        inputEl.value = btn.dataset.q;
        sendMessage();
    });
});

formEl.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage();
});

newChatBtn.addEventListener('click', () => {
    sessionId = null;
    localStorage.removeItem('h1ai_session_id');
    userId = generateUserId();
    localStorage.setItem('h1ai_user_id', userId);
    resetChat();
});

clearChatBtn.addEventListener('click', () => {
    if (confirm('مسح المحادثة؟')) {
        resetChat();
    }
});

// ─── Restore session ────────────────────────────────────
const savedSession = localStorage.getItem('h1ai_session_id');
if (savedSession) {
    sessionId = savedSession;
    updateSessionInfo();
}

// ─── Send Message ───────────────────────────────────────
async function sendMessage() {
    const text = inputEl.value.trim();
    if (!text || isWaiting) return;

    // Clear input
    inputEl.value = '';
    inputEl.focus();

    // Remove welcome if first message
    const welcome = chatEl.querySelector('.welcome');
    if (welcome) welcome.remove();

    // Add user message
    addMessage('user', text);

    // Show typing
    isWaiting = true;
    sendBtn.disabled = true;
    typingEl.style.display = 'flex';
    scrollToBottom();

    const startTime = Date.now();

    try {
        const res = await fetch(`${API_BASE}/api/chat/message`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                message: text,
                channel: 'web',
                channel_user_id: userId,
                pharmacy_id: PHARMACY_ID,
            }),
        });

        if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
        }

        const data = await res.json();

        // Save session
        if (data.session_id && data.session_id !== sessionId) {
            sessionId = data.session_id;
            localStorage.setItem('h1ai_session_id', sessionId);
            updateSessionInfo();
        }

        const elapsed = Date.now() - startTime;
        addMessage('bot', data.text, data.tools_used, elapsed);
    } catch (err) {
        console.error('Send failed:', err);
        addMessage('bot', 'معلش، حصلت مشكلة في الاتصال. حاول تاني.', [], 0, true);
    } finally {
        isWaiting = false;
        sendBtn.disabled = false;
        typingEl.style.display = 'none';
        scrollToBottom();
    }
}

// ─── Add Message ────────────────────────────────────────
function addMessage(role, text, tools = [], elapsedMs = 0, isError = false) {
    const msg = document.createElement('div');
    msg.className = `message ${role}`;

    const avatar = document.createElement('div');
    avatar.className = 'msg-avatar';
    avatar.textContent = role === 'user' ? '👤' : '💊';

    const content = document.createElement('div');
    content.className = 'msg-content';

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    if (isError) bubble.classList.add('error-bubble');
    bubble.textContent = text;

    content.appendChild(bubble);

    // Tools badges
    if (tools && tools.length > 0) {
        const toolsEl = document.createElement('div');
        toolsEl.className = 'msg-tools';
        const toolLabels = {
            'search_drug': '🔍 بحث دواء',
            'check_availability': '📦 توفر',
            'check_price': '💰 سعر',
            'find_alternatives': '🔄 بدائل',
        };
        tools.forEach(t => {
            const badge = document.createElement('span');
            badge.className = 'tool-badge';
            badge.textContent = toolLabels[t] || t;
            toolsEl.appendChild(badge);
        });
        content.appendChild(toolsEl);
    }

    // Time
    const time = document.createElement('div');
    time.className = 'msg-time';
    const now = new Date();
    const timeStr = now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
    const metaParts = [timeStr];
    if (elapsedMs > 0) metaParts.push(`${(elapsedMs / 1000).toFixed(1)}ث`);
    time.textContent = metaParts.join(' · ');
    content.appendChild(time);

    msg.appendChild(avatar);
    msg.appendChild(content);

    chatEl.appendChild(msg);
    scrollToBottom();
}

// ─── Reset Chat ─────────────────────────────────────────
function resetChat() {
    chatEl.innerHTML = `
        <div class="welcome">
            <div class="welcome-icon">💊</div>
            <h2>أهلاً بيك 👋</h2>
            <p>أنا مساعد صيدلية H1-AI.<br>اسألني عن أي دواء، سعره، أو بديله.</p>
            <div class="suggestions">
                <button class="suggestion" data-q="عندك بنادول؟">🔍 عندك بنادول؟</button>
                <button class="suggestion" data-q="بكام الفولتارين؟">💰 بكام الفولتارين؟</button>
                <button class="suggestion" data-q="عندك أوجمنتين؟">💊 عندك أوجمنتين؟</button>
                <button class="suggestion" data-q="فيه بديل أرخص للبنادول؟">🔄 فيه بديل أرخص للبنادول؟</button>
                <button class="suggestion" data-q="دوا للصداع">🤕 دوا للصداع</button>
                <button class="suggestion" data-q="دوا للبرد">🤧 دوا للبرد</button>
            </div>
        </div>
    `;
    // Re-attach handlers
    document.querySelectorAll('.suggestion').forEach(btn => {
        btn.addEventListener('click', () => {
            inputEl.value = btn.dataset.q;
            sendMessage();
        });
    });
    updateSessionInfo();
}

// ─── Utils ──────────────────────────────────────────────
function scrollToBottom() {
    requestAnimationFrame(() => {
        chatEl.scrollTop = chatEl.scrollHeight;
    });
}

function updateSessionInfo() {
    if (sessionId) {
        sessionInfoEl.textContent = `🔗 جلسة: ${sessionId.substring(0, 8)}...`;
    } else {
        sessionInfoEl.textContent = '✨ جلسة جديدة';
    }
}

// ─── Load history on start ──────────────────────────────
(async function loadHistory() {
    if (!sessionId) return;
    try {
        const res = await fetch(`${API_BASE}/api/chat/sessions/${sessionId}/messages?limit=20`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.messages && data.messages.length > 0) {
            const welcome = chatEl.querySelector('.welcome');
            if (welcome) welcome.remove();

            data.messages.forEach(m => {
                addMessage(m.role === 'user' ? 'user' : 'bot', m.content);
            });
        }
    } catch (e) {
        console.error('Load history failed:', e);
    }
})();

// ─── Focus input ────────────────────────────────────────
window.addEventListener('load', () => {
    setTimeout(() => inputEl.focus(), 100);
});

// ─── Prevent double-tap zoom ────────────────────────────
let lastTouch = 0;
document.addEventListener('touchend', (e) => {
    const now = Date.now();
    if (now - lastTouch <= 300) e.preventDefault();
    lastTouch = now;
}, { passive: false });
