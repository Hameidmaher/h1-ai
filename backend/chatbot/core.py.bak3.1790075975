"""
H1-AI ChatbotCore — المحرك الرئيسي
"""
from __future__ import annotations
import time
import structlog
from dataclasses import dataclass, field

from llm.factory import create_llm
from security import input_guard, output_guard, llm_breaker, CircuitOpenError
from chatbot.tools.registry import get_registry, ToolResult
from chatbot.memory.session import SessionManager
from chatbot.prompts.system_ar import SYSTEM_PROMPT_AR, CONTEXT_HEADER
try:
    from chatbot.nlu.franco_arab import is_franco, normalize_franco
except ImportError:
    is_franco = lambda x: False
    normalize_franco = lambda x: x

logger = structlog.get_logger()

# ملاحظة: الملف ده بيستخدم security.circuit_breaker (async)
# الملف chatbot/circuit_breaker.py القديم مش مستخدم (deprecated)

FAQ_KEYWORDS = [
    "مواعيد", "بتفتحوا", "بتقفلوا", "فاتحين",
    "توصيل", "دليفري", "توصلوا", "بتوصلوا", "بيت", "شحن",
    "دفع", "فيزا", "كارت", "كاش", "أونلاين",
    "استرجاع", "ترجع", "ترجيح",
    "روشتة", "وصفة",
    "سياسة", "خصوصية",
    "فروع", "فرع",
    "عنوان", "مكان",
]


@dataclass
class ChatResponse:
    text: str
    session_id: str
    message_id: int | None = None
    tool_calls: list = field(default_factory=list)
    tokens_in: int = 0
    tokens_out: int = 0
    latency_ms: int = 0
    model: str = ""
    is_error: bool = False


class ChatbotCore:
    MAX_TOOL_ITERATIONS = 3
    MAX_CONTEXT_MESSAGES = 8   # آخر 8 رسائل فقط (4 user + 4 assistant)
    MAX_TOKENS_ESTIMATE = 8000 # حد أقصى تقريبي للسياق

    def _truncate_context(self, msgs: list) -> list:
        """اقتطع السياق للحد الأقصى."""
        if len(msgs) <= self.MAX_CONTEXT_MESSAGES:
            return msgs
        # احتفظ بالأول والأخير من السياق
        head = msgs[:2]  # أول رسالتين مهمين للسياق الأولي
        tail = msgs[-(self.MAX_CONTEXT_MESSAGES - 2):]
        return head + tail

    def __init__(self):
        self.llm = create_llm(temperature=0.4)
        self.registry = get_registry()
        self.sessions = SessionManager()
        self.tools_schema = self.registry.openai_schemas()
        if self.tools_schema:
            try:
                self.llm = self.llm.bind_tools(self.tools_schema)
                logger.info("chatbot.tools_bound", count=len(self.tools_schema))
            except Exception as e:
                logger.warning("chatbot.bind_tools_failed", error=str(e)[:150])

    def _should_presearch(self, message: str) -> bool:
        return any(kw in message for kw in FAQ_KEYWORDS)

    async def _presearch_knowledge(self, message: str) -> list[dict]:
        try:
            from chatbot.tools.knowledge import search_knowledge_handler
            result = await search_knowledge_handler(query=message, limit=3)
            if result.success and result.data:
                return result.data.get("results", [])
        except Exception as e:
            logger.warning("core.presearch_failed", error=str(e)[:100])
        return []

    async def chat(
        self,
        message: str,
        channel: str = "web",
        channel_user_id: str = "anonymous",
        pharmacy_id: str | None = None,
        customer_id: str | None = None,
    ) -> ChatResponse:
        start = time.monotonic()

        # ═══ INPUT GUARDRAILS ═══
        in_guard = input_guard.check(message)
        if not in_guard.is_safe:
            logger.warning("chat.input_blocked",
                           reason=in_guard.reason,
                           action=in_guard.action)

            session = await self.sessions.get_or_create(
                channel=channel,
                channel_user_id=channel_user_id,
                pharmacy_id=pharmacy_id,
                customer_id=customer_id,
            )
            await self.sessions.save_message(
                session_id=session["id"],
                role="user",
                content=message,
            )
            msg_id = await self.sessions.save_message(
                session_id=session["id"],
                role="assistant",
                content=in_guard.suggested_response or "معلش، مش قادر أساعد في ده.",
            )
            return ChatResponse(
                text=in_guard.suggested_response or "معلش، مش قادر أساعد في ده.",
                session_id=session["id"],
                message_id=msg_id,
                latency_ms=int((time.monotonic() - start) * 1000),
                model="guardrails",
            )

        # Franco-Arab normalization
        if is_franco(message):
            normalized = normalize_franco(message)
            logger.info('chat.franco_detected', original=message[:50], normalized=normalized[:50])
            message = normalized

        session = await self.sessions.get_or_create(
            channel=channel,
            channel_user_id=channel_user_id,
            pharmacy_id=pharmacy_id,
            customer_id=customer_id,
        )

        await self.sessions.save_message(
            session_id=session["id"],
            role="user",
            content=message,
        )

        # ═══════════════════════════════════════════════════
        #  FAQ Fast-path
        # ═══════════════════════════════════════════════════
        # FAQ path — يعمل بدون LLM
        if self._should_presearch(message):
            preknowledge = await self._presearch_knowledge(message)

            if preknowledge:
                top_result = preknowledge[0]
                match_type = top_result.get("match_type", "vector")

                # نقبل category/keyword دايماً
                accept = match_type in ("category", "keyword")

                if accept:
                    top = preknowledge[:2]
                    answer = "\n\n".join([r["content"] for r in top if r.get("content")])

                    latency = int((time.monotonic() - start) * 1000)
                    tool_call = {
                        "name": "search_knowledge",
                        "args": {"query": message},
                        "result": top,
                        "error": None,
                    }

                    # ═══ OUTPUT GUARDRAILS (FAQ path) ═══
                    out_guard = output_guard.check(answer)
                    if out_guard.action == "warn" and out_guard.suggested_response:
                        answer = out_guard.suggested_response

                    msg_id = await self.sessions.save_message(
                        session_id=session["id"],
                        role="assistant",
                        content=answer,
                        tool_calls=[tool_call],
                        latency_ms=latency,
                    )

                    logger.info("chat.faq_fastpath",
                                match_type=match_type,
                                results=len(top),
                                latency_ms=latency)

                    return ChatResponse(
                        text=answer,
                        session_id=session["id"],
                        message_id=msg_id,
                        tool_calls=[tool_call],
                        latency_ms=latency,
                        model="knowledge_base (RAG)",
                    )

        # ═══════════════════════════════════════════════════
        #  Normal LLM flow
        # ═══════════════════════════════════════════════════
        context_msgs = await self.sessions.get_context(session["id"])
        # ✂️ Context window truncation
        context_msgs = self._truncate_context(context_msgs)

        system = SYSTEM_PROMPT_AR
        if session["pharmacy_id"]:
            system += "\n" + CONTEXT_HEADER.format(
                pharmacy_name=session["pharmacy_id"],
                customer_name=session.get("customer_id") or "غير معروف",
                channel=channel,
                message_count=session["total_messages"] + 1,
            )

        messages = [{"role": "system", "content": system}]
        messages.extend(context_msgs[:-1] if len(context_msgs) > 1 else context_msgs)
        messages.append({"role": "user", "content": message})

        # ⚠️ تقدير حجم السياق
        estimated_tokens = sum(len(m.get("content", "")) for m in messages) // 4
        if estimated_tokens > self.MAX_TOKENS_ESTIMATE:
            logger.warning("chat.context_too_large",
                          estimated=estimated_tokens,
                          limit=self.MAX_TOKENS_ESTIMATE)

        try:
            response = await llm_breaker.call(
                self._run_llm_loop,
                messages=messages,
                tool_context={
                    "pharmacy_id": session["pharmacy_id"],
                    "customer_id": session["customer_id"],
                },
            )
        except CircuitOpenError:
            logger.warning("chatbot.circuit_open")
            response = {
                "text": "النظام تحت ضغط شوية. جرب تاني بعد دقيقة، أو كلم الصيدلي مباشرة.",
                "tool_calls": [],
                "tokens_in": 0,
                "tokens_out": 0,
                "is_error": True,
            }
        except Exception as e:
            logger.error("chatbot.llm_failed", error=str(e)[:200])
            response = {
                "text": "معلش، حصلت مشكلة تقنية. جرب تاني.",
                "tool_calls": [],
                "tokens_in": 0,
                "tokens_out": 0,
                "is_error": True,
            }

        latency = int((time.monotonic() - start) * 1000)

        # ═══ OUTPUT GUARDRAILS ═══
        out_guard = output_guard.check(response["text"])
        if out_guard.action == "warn" and out_guard.suggested_response:
            logger.info("chat.output_warned", reason=out_guard.reason)
            response["text"] = out_guard.suggested_response
        elif not out_guard.is_safe:
            logger.warning("chat.output_blocked", reason=out_guard.reason)
            response["text"] = "معلش، مش قادر أجاوب على السؤال ده دلوقتي. كلم الصيدلي مباشرة."

        msg_id = await self.sessions.save_message(
            session_id=session["id"],
            role="assistant",
            content=response["text"],
            tool_calls=response.get("tool_calls"),
            tokens_in=response.get("tokens_in", 0),
            tokens_out=response.get("tokens_out", 0),
            latency_ms=latency,
            is_error=response.get("is_error", False),
        )

        return ChatResponse(
            text=response["text"],
            session_id=session["id"],
            message_id=msg_id,
            tool_calls=response.get("tool_calls", []),
            tokens_in=response.get("tokens_in", 0),
            tokens_out=response.get("tokens_out", 0),
            latency_ms=latency,
            model=getattr(self.llm, "model_name", "unknown"),
            is_error=response.get("is_error", False),
        )

    async def _run_llm_loop(self, messages, tool_context):
        from langchain_core.messages import ToolMessage

        lc_messages = self._to_langchain(messages)
        tool_calls_made = []
        total_in = 0
        total_out = 0

        for iteration in range(self.MAX_TOOL_ITERATIONS):
            response = await self.llm.ainvoke(lc_messages)
            usage = getattr(response, "usage_metadata", {}) or {}
            total_in += usage.get("input_tokens", 0)
            total_out += usage.get("output_tokens", 0)

            tool_calls = getattr(response, "tool_calls", None) or []

            if not tool_calls:
                return {
                    "text": response.content if isinstance(response.content, str) else str(response.content),
                    "tool_calls": tool_calls_made,
                    "tokens_in": total_in,
                    "tokens_out": total_out,
                    "is_error": False,
                }

            lc_messages.append(response)
            for tc in tool_calls:
                tool_name = tc.get("name")
                args = tc.get("args", {})
                tool_id = tc.get("id", "")

                result = await self.registry.execute(
                    name=tool_name,
                    arguments=args,
                    context=tool_context,
                )

                tool_calls_made.append({
                    "name": tool_name,
                    "args": args,
                    "result": result.data if result.success else None,
                    "error": result.error,
                })

                lc_messages.append(ToolMessage(
                    content=str(result.data or result.error or ""),
                    tool_call_id=tool_id,
                ))

        return {
            "text": "معلش، احتاج شوية وقت. ممكن تعيد السؤال؟",
            "tool_calls": tool_calls_made,
            "tokens_in": total_in,
            "tokens_out": total_out,
            "is_error": False,
        }

    def _to_langchain(self, messages):
        from langchain_core.messages import HumanMessage, SystemMessage, AIMessage

        result = []
        for m in messages:
            role = m["role"]
            content = m["content"]
            if role == "system":
                result.append(SystemMessage(content=content))
            elif role == "user":
                result.append(HumanMessage(content=content))
            elif role == "assistant":
                result.append(AIMessage(content=content))
        return result


_core: ChatbotCore | None = None


def get_core() -> ChatbotCore:
    global _core
    if _core is None:
        _core = ChatbotCore()
    return _core
