<script>
// ═══════════════════════════════════════════════════════════
//  PWA — Service Worker Registration
// ═══════════════════════════════════════════════════════════
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('✅ SW registered:', reg.scope))
            .catch(err => console.log('❌ SW failed:', err));
    });
}

// Install prompt
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    // اعرض زر التثبيت
    showInstallButton();
});

function showInstallButton() {
    if (document.getElementById('pwa-install-btn')) return;

    const btn = document.createElement('button');
    btn.id = 'pwa-install-btn';
    btn.innerHTML = '📱 ثبّت التطبيق';
    btn.style.cssText = `
        position: fixed;
        bottom: 20px;
        left: 20px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        color: white;
        border: none;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(14,165,233,0.4);
        z-index: 9999;
        font-family: inherit;
        direction: rtl;
        animation: slideUp 0.5s ease;
    `;

    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideUp {
            from { transform: translateY(100px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    `;
    document.head.appendChild(style);

    btn.onclick = async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
            btn.remove();
        }
        deferredPrompt = null;
    };

    document.body.appendChild(btn);

    // اختفِ بعد 30 ثانية لو المستخدم ماثبتش
    setTimeout(() => btn.remove(), 30000);
}

// Detect standalone mode
if (window.matchMedia('(display-mode: standalone)').matches) {
    console.log('📱 Running as installed app');
    document.body.classList.add('pwa-mode');
}
</script>
<!-- FORCE_RELOAD_START -->
<script>
(function() {
  // Force reload مرة واحدة كل مرة يتغير فيها رقم النسخة
  var RELOAD_KEY = "h1ai_reload_version";
  var CURRENT_VERSION = "1790072344";

  // افحص لو النسخة قديمة
  var storedVersion = localStorage.getItem(RELOAD_KEY);
  if (storedVersion !== CURRENT_VERSION) {
    console.log("🔄 Cache bust: " + storedVersion + " → " + CURRENT_VERSION);
    localStorage.setItem(RELOAD_KEY, CURRENT_VERSION);

    // سجّل offline الـ service worker
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.getRegistrations().then(function(regs) {
        for (var i = 0; i < regs.length; i++) {
          regs[i].unregister();
        }
      });
    }

    // امسح caches
    if ("caches" in window) {
      caches.keys().then(function(names) {
        for (var i = 0; i < names.length; i++) {
          caches.delete(names[i]);
        }
      });
    }

    // hard reload
    setTimeout(function() {
      location.reload(true);
    }, 300);
  }
})();
</script>
<!-- FORCE_RELOAD_END -->
<script>
// H1-AI Admin — PWA Registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', async () => {
    try {
      const reg = await navigator.serviceWorker.register('/admin/static/sw.js', { scope: '/admin/' });
      console.log('✅ SW registered:', reg.scope);

      // Update detection
      reg.addEventListener('updatefound', () => {
        const newWorker = reg.installing;
        newWorker.addEventListener('statechange', () => {
          if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
            if (confirm('🔄 نسخة جديدة متاحة! تحديث الآن؟')) {
              newWorker.postMessage({ type: 'SKIP_WAITING' });
              window.location.reload();
            }
          }
        });
      });
    } catch (err) {
      console.log('❌ SW failed:', err);
    }
  });
}

</script>

