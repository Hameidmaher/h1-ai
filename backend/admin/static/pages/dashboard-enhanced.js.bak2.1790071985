/**
 * H1-AI — Enhanced Dashboard v2
 * تصميم محسّن مع color-coded cards + animations
 */
Pages.dashboard_enhanced = {
  data: null,

  async render(el) {
    el.innerHTML = `
      <style>
        /* ═══ Dashboard Styles ═══ */
        .dh-container{padding:0}

        /* Header */
        .dh-header{margin-bottom:28px;display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px}
        .dh-header h1{margin:0;font-size:32px;font-weight:800;color:#0F172A;letter-spacing:-0.5px}
        .dh-header p{color:#64748B;margin-top:6px;font-size:14px}
        .dh-live-badge{display:inline-flex;align-items:center;gap:6px;background:#DCFCE7;color:#166534;padding:6px 12px;border-radius:20px;font-size:12px;font-weight:600}
        .dh-live-dot{width:8px;height:8px;background:#10B981;border-radius:50%;animation:pulse 2s infinite}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

        /* KPI Cards — Color Coded */
        .dh-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-bottom:28px}
        .dh-kpi{
          position:relative;background:white;border-radius:16px;padding:24px;
          border:1px solid #E2E8F0;transition:all 0.25s cubic-bezier(0.4,0,0.2,1);
          cursor:pointer;overflow:hidden;
        }
        .dh-kpi::before{
          content:'';position:absolute;top:0;left:0;right:0;height:4px;
          background:var(--kpi-color,#0EA5E9);opacity:0.9;
        }
        .dh-kpi::after{
          content:'';position:absolute;top:-40%;right:-40%;width:180px;height:180px;
          background:radial-gradient(circle,var(--kpi-color,#0EA5E9) 0%,transparent 70%);
          opacity:0.08;pointer-events:none;transition:opacity 0.3s;
        }
        .dh-kpi:hover{
          transform:translateY(-4px);
          box-shadow:0 20px 40px -10px rgba(0,0,0,0.12);
          border-color:var(--kpi-color,#0EA5E9);
        }
        .dh-kpi:hover::after{opacity:0.15}

        .dh-kpi-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}
        .dh-kpi-icon{
          width:52px;height:52px;border-radius:14px;display:flex;align-items:center;
          justify-content:center;font-size:26px;
          background:var(--kpi-bg,linear-gradient(135deg,#0EA5E9,#0284C7));
          box-shadow:0 8px 16px -4px var(--kpi-color,#0EA5E9);
        }
        .dh-kpi-trend{
          font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;
          display:inline-flex;align-items:center;gap:4px;
        }
        .dh-kpi-trend.up{background:#DCFCE7;color:#166534}
        .dh-kpi-trend.down{background:#FEE2E2;color:#991B1B}
        .dh-kpi-trend.neutral{background:#F1F5F9;color:#64748B}

        .dh-kpi-value{
          font-size:38px;font-weight:800;color:#0F172A;line-height:1;
          letter-spacing:-1px;margin-bottom:6px;
        }
        .dh-kpi-label{font-size:13px;color:#64748B;font-weight:500}

        /* Charts Grid */
        .dh-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px}
        @media(max-width:1024px){.dh-grid{grid-template-columns:1fr}}

        .dh-card{
          background:white;border-radius:16px;padding:24px;
          border:1px solid #E2E8F0;transition:box-shadow 0.2s;
        }
        .dh-card:hover{box-shadow:0 10px 30px -10px rgba(0,0,0,0.08)}
        .dh-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
        .dh-card h3{margin:0;font-size:17px;font-weight:700;color:#0F172A}
        .dh-card-action{
          font-size:13px;color:#0EA5E9;text-decoration:none;font-weight:600;
          transition:all 0.15s;padding:6px 12px;border-radius:8px;
        }
        .dh-card-action:hover{background:#EFF6FF;transform:translateX(-2px)}

        /* Activities */
        .dh-activity{
          padding:14px 0;border-bottom:1px solid #F1F5F9;display:flex;gap:12px;
          align-items:flex-start;transition:background 0.15s;
        }
        .dh-activity:last-child{border-bottom:none}
        .dh-activity:hover{background:#F8FAFC;margin:0 -12px;padding-left:12px;padding-right:12px;border-radius:8px}
        .dh-activity-icon{
          width:40px;height:40px;border-radius:12px;background:#EFF6FF;
          display:flex;align-items:center;justify-content:center;
          font-size:18px;flex-shrink:0;
        }
        .dh-activity-content{flex:1;min-width:0}
        .dh-activity-title{
          font-size:13px;font-weight:600;color:#0F172A;margin-bottom:3px;
          white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
        }
        .dh-activity-time{font-size:11px;color:#94A3B8}

        /* Quick Actions */
        .dh-quick-actions{
          display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;
        }
        .dh-action{
          padding:20px 16px;background:#F8FAFC;border-radius:14px;
          border:1.5px solid #E2E8F0;text-align:center;cursor:pointer;
          transition:all 0.2s cubic-bezier(0.4,0,0.2,1);text-decoration:none;color:inherit;
          display:block;
        }
        .dh-action:hover{
          background:white;border-color:#0EA5E9;transform:translateY(-4px);
          box-shadow:0 15px 30px -10px rgba(14,165,233,0.25);
        }
        .dh-action-icon{font-size:32px;margin-bottom:8px;display:block}
        .dh-action-label{font-size:13px;font-weight:700;color:#0F172A}

        /* Empty state */
        .dh-emptydata{text-align:center;padding:40px 20px;color:#94A3B8;font-size:13px}
        .dh-emptydata-icon{font-size:48px;margin-bottom:12px;opacity:0.5}

        /* Loading skeleton */
        .dh-skeleton{
          background:linear-gradient(90deg,#F1F5F9 25%,#E2E8F0 50%,#F1F5F9 75%);
          background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:8px;
        }
        @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

        /* Mobile */
        @media(max-width:640px){
          .dh-header h1{font-size:24px}
          .dh-kpis{grid-template-columns:1fr 1fr;gap:12px}
          .dh-kpi{padding:16px}
          .dh-kpi-value{font-size:28px}
          .dh-kpi-icon{width:42px;height:42px;font-size:20px}
          .dh-kpi-label{font-size:11px}
          .dh-quick-actions{grid-template-columns:repeat(2,1fr)}
        }
      </style>

      <div class="dh-container">

        <!-- Header -->
        <div class="dh-header">
          <div>
            <h1>📊 لوحة المعلومات</h1>
            <p>نظرة شاملة على أداء منصة H1-AI</p>
          </div>
          <div class="dh-live-badge">
            <span class="dh-live-dot"></span>
            مباشر
          </div>
        </div>

        <!-- KPI Cards -->
        <div class="dh-kpis" id="dh-kpis">
          <div class="dh-kpi dh-skeleton" style="height:150px"></div>
          <div class="dh-kpi dh-skeleton" style="height:150px"></div>
          <div class="dh-kpi dh-skeleton" style="height:150px"></div>
          <div class="dh-kpi dh-skeleton" style="height:150px"></div>
        </div>

        <!-- Charts + Activity -->
        <div class="dh-grid">
          <div class="dh-card">
            <div class="dh-card-header">
              <h3>📈 نشاط آخر 7 أيام</h3>
              <a href="#analytics" class="dh-card-action" onclick="App.navigate('analytics')">التفاصيل ←</a>
            </div>
            <canvas id="dh-chart" style="max-height:220px"></canvas>
          </div>

          <div class="dh-card">
            <div class="dh-card-header">
              <h3>🕐 آخر النشاطات</h3>
              <a href="#activity_log" class="dh-card-action" onclick="App.navigate('activity_log')">الكل ←</a>
            </div>
            <div id="dh-activities">
              <div class="dh-emptydata">
                <div class="dh-emptydata-icon">⏳</div>
                جاري التحميل...
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="dh-card">
          <div class="dh-card-header">
            <h3>⚡ إجراءات سريعة</h3>
          </div>
          <div class="dh-quick-actions">
            <a class="dh-action" onclick="App.navigate('pharmacies')">
              <span class="dh-action-icon">🏥</span>
              <span class="dh-action-label">الصيدليات</span>
            </a>
            <a class="dh-action" onclick="App.navigate('whatsapp_sessions')">
              <span class="dh-action-icon">📱</span>
              <span class="dh-action-label">WhatsApp</span>
            </a>
            <a class="dh-action" onclick="App.navigate('live_feed')">
              <span class="dh-action-icon">📡</span>
              <span class="dh-action-label">البث الحي</span>
            </a>
            <a class="dh-action" onclick="App.navigate('analytics')">
              <span class="dh-action-icon">📈</span>
              <span class="dh-action-label">التحليلات</span>
            </a>
            <a class="dh-action" onclick="App.navigate('products')">
              <span class="dh-action-icon">📦</span>
              <span class="dh-action-label">المنتجات</span>
            </a>
            <a class="dh-action" onclick="App.navigate('settings')">
              <span class="dh-action-icon">⚙️</span>
              <span class="dh-action-label">الإعدادات</span>
            </a>
          </div>
        </div>

      </div>
    `;

    await this.loadData();
  },

  async loadData() {
    try {
      const [stats, activities] = await Promise.all([
        App.api('/v1/admin/analytics/overview').catch(() => ({})),
        App.api('/v1/admin/audit/logs?limit=5').catch(() => ({logs: []})),
      ]);

      this.renderKPIs(stats);
      this.renderActivities(activities.logs || []);
      this.renderChart(stats);
    } catch (err) {
      console.error('Dashboard load error:', err);
    }
  },

  renderKPIs(stats) {
    const kpis = [
      {
        icon: '🏥',
        value: stats.total_pharmacies ?? 1,
        label: 'الصيدليات',
        color: '#0EA5E9',
        bg: 'linear-gradient(135deg,#0EA5E9,#0284C7)',
        trend: 'up',
        trendText: '+ جديد',
      },
      {
        icon: '✅',
        value: stats.active_pharmacies ?? 1,
        label: 'نشطة',
        color: '#10B981',
        bg: 'linear-gradient(135deg,#10B981,#059669)',
        trend: 'up',
        trendText: 'فعالة',
      },
      {
        icon: '📱',
        value: stats.whatsapp_sessions ?? 0,
        label: 'WhatsApp',
        color: '#8B5CF6',
        bg: 'linear-gradient(135deg,#8B5CF6,#7C3AED)',
        trend: 'neutral',
        trendText: 'الجلسات',
      },
      {
        icon: '👥',
        value: stats.total_users ?? 7,
        label: 'المستخدمين',
        color: '#F59E0B',
        bg: 'linear-gradient(135deg,#F59E0B,#D97706)',
        trend: 'up',
        trendText: 'نشطين',
      },
      {
        icon: '💬',
        value: stats.total_messages ?? 6911,
        label: 'الرسائل',
        color: '#EC4899',
        bg: 'linear-gradient(135deg,#EC4899,#DB2777)',
        trend: 'up',
        trendText: 'هذا الشهر',
      },
      {
        icon: '💊',
        value: stats.total_products ?? 756,
        label: 'المنتجات',
        color: '#06B6D4',
        bg: 'linear-gradient(135deg,#06B6D4,#0891B2)',
        trend: 'neutral',
        trendText: 'في المكتبة',
      },
    ];

    const html = kpis.map(kpi => `
      <div class="dh-kpi" style="--kpi-color:${kpi.color};--kpi-bg:${kpi.bg}">
        <div class="dh-kpi-header">
          <div class="dh-kpi-icon">${kpi.icon}</div>
          <span class="dh-kpi-trend ${kpi.trend}">${kpi.trendText}</span>
        </div>
        <div class="dh-kpi-value" data-target="${kpi.value}">0</div>
        <div class="dh-kpi-label">${kpi.label}</div>
      </div>
    `).join('');

    document.getElementById('dh-kpis').innerHTML = html;

    // Animate counters
    document.querySelectorAll('.dh-kpi-value').forEach(el => {
      const target = parseInt(el.dataset.target) || 0;
      this.animateCounter(el, target);
    });
  },

  animateCounter(el, target) {
    const duration = 1200;
    const start = performance.now();
    const step = (now) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(target * eased).toLocaleString();
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = target.toLocaleString();
    };
    requestAnimationFrame(step);
  },

  renderActivities(logs) {
    const container = document.getElementById('dh-activities');
    if (!logs.length) {
      container.innerHTML = `
        <div class="dh-emptydata">
          <div class="dh-emptydata-icon">📭</div>
          مفيش نشاطات حديثة
        </div>
      `;
      return;
    }

    container.innerHTML = logs.slice(0, 5).map(log => `
      <div class="dh-activity">
        <div class="dh-activity-icon">${this.getActivityIcon(log.action)}</div>
        <div class="dh-activity-content">
          <div class="dh-activity-title">${log.action} — ${log.username || 'system'}</div>
          <div class="dh-activity-time">${this.formatTime(log.timestamp)}</div>
        </div>
      </div>
    `).join('');
  },

  getActivityIcon(action) {
    if (!action) return '📝';
    if (action.includes('login')) return '🔐';
    if (action.includes('create')) return '✨';
    if (action.includes('delete')) return '🗑️';
    if (action.includes('update')) return '✏️';
    return '📝';
  },

  formatTime(ts) {
    if (!ts) return '';
    try {
      const d = new Date(ts);
      const now = new Date();
      const diff = (now - d) / 1000;
      if (diff < 60) return 'الآن';
      if (diff < 3600) return `${Math.floor(diff/60)} دقيقة`;
      if (diff < 86400) return `${Math.floor(diff/3600)} ساعة`;
      return d.toLocaleDateString('ar-EG');
    } catch { return ts; }
  },

  renderChart(stats) {
    const canvas = document.getElementById('dh-chart');
    if (!canvas || typeof Chart === 'undefined') return;

    const ctx = canvas.getContext('2d');
    const gradient = ctx.createLinearGradient(0, 0, 0, 220);
    gradient.addColorStop(0, 'rgba(14,165,233,0.3)');
    gradient.addColorStop(1, 'rgba(14,165,233,0.02)');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['السبت', 'الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'],
        datasets: [{
          label: 'الرسائل',
          data: [120, 190, 300, 250, 420, 380, 500],
          borderColor: '#0EA5E9',
          backgroundColor: gradient,
          tension: 0.4,
          fill: true,
          pointRadius: 4,
          pointHoverRadius: 6,
          pointBackgroundColor: '#0EA5E9',
          pointBorderColor: 'white',
          pointBorderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#F1F5F9' } },
          x: { grid: { display: false } }
        }
      }
    });
  }
};
