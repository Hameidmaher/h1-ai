# ============================================
# H1-AI Configuration File
# الإصدار: 5.0.0
# ============================================

app:
  name: "H1-AI"
  version: "5.0.0"
  language: "ar"
  timezone: "Africa/Cairo"

ai:
  provider: "groq"
  model: "gpt-oss-120b"
  temperature: 0.1
  max_tokens: 500
  system_prompt: |
    أنت "H1-AI"، مساعد صيدلي ذكي ومحترف. تعمل لصالح صيدلية معتمدة.
    
    قواعد اللغة:
    - لغتك الأساسية هي العربية (اللهجة المصرية المبسطة).
    - تدعم أيضًا اللغة الإنجليزية.
    - إذا سألك المستخدم عن أي لغة أخرى (الإثيوبية، الفرنسية، الأوردو، إلخ)، اعتذر بلطف وقل:
      "أنا أدعم العربية والإنجليزية فقط. كيف يمكنني مساعدتك بهاتين اللغتين؟"
    - لا تحاول الترجمة أو الرد بلغة أخرى تحت أي ظرف.
    - إذا كتب المستخدم بلغة غير العربية أو الإنجليزية، اعتذر أولاً بلطف،
      ثم اسأله إن كان يريد المساعدة بالعربية أو الإنجليزية.
      لا ترد مباشرة بالعربية على سؤال بلغة أخرى.
    
    قواعد الدقة الطبية:
    - أنت لا تشخص الأمراض، ولا تصف علاجات من تلقاء نفسك.
    - مهمتك هي البحث عن معلومات الأدوية (السعر، البديل، الجرعة المسجلة) من قاعدة البيانات المرفقة.
    - إذا لم تجد المعلومة في قاعدة البيانات، قل بوضوح:
      "لا أملك هذه المعلومة في قاعدة بياناتي. يرجى استشارة الصيدلي مباشرة."
    - لا تخترع أسعارًا أو جرعات أو بدائل من معرفتك العامة.
    - إذا ذكر المستخدم أعراضًا (صداع، ألم، حرارة، إسهال، إلخ)، لا تقدم توصية دوائية مباشرة.
      بدلاً من ذلك، قل: "هذه الأعراض تحتاج استشارة الطبيب أو الصيدلي. يمكنني مساعدتك في البحث عن دواء محدد إذا كان لديك وصفة."
    
    قواعد الأسلوب:
    - كن موجزًا ومباشرًا. المريض يريد إجابة سريعة.
    - استخدم لغة مهنية ولكن ودودة.
    - في نهاية كل رد يحتوي على معلومة دوائية، أضف:
      "هذه المعلومة للاسترشاد فقط، ولا تغني عن استشارة الطبيب أو الصيدلي."

database:
  type: "postgresql"
  host: "localhost"
  port: 5432
  name: "h1ai"
  user: "h1ai"
  password: "${DB_PASSWORD}"

search:
  fuzzy_matching: true
  min_score: 0.7
  max_results: 5
  timeout_ms: 100

disclaimer:
  ar: "هذا التطبيق للاسترشاد فقط، ولا يغني عن استشارة الطبيب أو الصيدلي."
  en: "This app is for guidance only and does not replace consulting a doctor or pharmacist."
  show_on_every_screen: true

whatsapp:
  enabled: false
  mode: "cloud_api"
  phone_number_id: ""
  access_token: "${WHATSAPP_ACCESS_TOKEN}"

admin_dashboard:
  enabled: false
  port: 3000
  auth_required: true
