# ═══════════════════════════════════════════════════════════
#  H1-AI .gitignore — Security First
# ═══════════════════════════════════════════════════════════

# ─── Secrets ───
.env
.env.*
!.env.example
*.key
*.pem
*.jks
*.keystore
keystore/
credentials.json
credentials.yml

# ─── WhatsApp Session (CRITICAL!) ───
whatsapp-bridge/auth/
whatsapp-bridge/.wwebjs_cache/
whatsapp-bridge/sessions/
whatsapp-bridge/*.session
whatsapp-bridge/.wwebjs_auth/
whatsapp/sessions/
whatsapp-service/sessions/
whatsapp-service/auth_info/
sessions/

# ─── Backups ───
backups/
*.sql
*.sql.gz
*.dump
*.backup
*.bak
*.bak.*
*.broken.*
*_backup_*
_backup_*
pwa_backup_*/
whatsapp_backup_*/
archived-projects/
mobile-backup-*/
.git.backup-*

# ─── Python ───
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── Node ───
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Logs ───
*.log
logs/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Mobile (Flutter) ───
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/ios/Pods/
mobile/.env
mobile-backup-*/
*.apk
*.symbols
*.map.json

# ─── Frontend ───
frontend/dist/
frontend/build/

# ─── Chrome/puppeteer ───
.chromium/
*.crx

# ─── Database ───
*.db
*.db-journal
h1ai.db
*.sqlite
*.sqlite3

# ─── Config with secrets ───
config/config.yaml
config/*.local.yaml

# ─── Android SDK ───
android-sdk/
.gradle/

# ─── Test results ───
/tmp/*.txt
main.py.*
*.before-*
