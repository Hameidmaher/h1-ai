# ═══════════════════════════════════════════════════════════
#  H1-AI .gitignore — Security First
# ═══════════════════════════════════════════════════════════

# ─── Secrets ───
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
credentials.yml

# ─── WhatsApp Session (CRITICAL!) ───
whatsapp-bridge/auth/
whatsapp-bridge/.wwebjs_cache/
whatsapp-bridge/sessions/
whatsapp-bridge/*.session
whatsapp-bridge/.wwebjs_auth/

# ─── Backups ───
backups/
*.sql
*.sql.gz
*.dump
*.backup

# ─── Python ───
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ─── Node ───
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.backup.*
*.backup

# ─── Logs ───
*.log
logs/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Build artifacts ───
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
frontend/dist/
frontend/build/

# ─── Chrome/puppeteer ───
.chromium/
*.crx

# whatsapp packages (large node_modules)
whatsapp/
whatsapp-bridge/
whatsapp-service/node_modules/
whatsapp-service/sessions/
whatsapp-service/auth_info/

# Backup files
*.bak
*.bak.*
*.backup
*.backup.*
*.broken.*
pwa_backup_*/
_backup_*/
whatsapp_backup_*/
archived-projects/

# Database files
*.db
h1ai.db
*.sqlite
backend/.env
